{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tezbar independent Rust process extension",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "slug",
    "version",
    "runtime",
    "execution",
    "protocolVersion",
    "commands",
    "preferences",
    "capabilities",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "runtime": {
      "const": "rust"
    },
    "execution": {
      "const": "process"
    },
    "protocolVersion": {
      "const": 1
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "title",
          "mode"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "refreshMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 500
          },
          "concurrency": {
            "enum": [
              "serialize",
              "reject-while-busy"
            ]
          }
        }
      }
    },
    "preferences": {
      "type": "array"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "artifacts": {
      "type": "object"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
